{
  // ── 翻译引擎配置（按引擎分区，选用对应引擎时填写）──
  // 引擎/目标语言/全量扫描并发在 Stash 插件页设置，不写在此处
  // google_free：免密钥，无需配置
  "engines": {
    "google_api": {
      "apiKey": ""
    },
    "microsoft": {
      "apiKey": "",
      "region": "global"
    },
    "baidu": {
      "appId": "",
      "secret": ""
    },
    "openai": {
      "apiKey": "",
      "model": "gpt-4o-mini",
      "baseUrl": ""
    },
    "deepl": {
      "apiKey": "",
      "freeApi": false,
      "baseUrl": ""
    }
  },

  // ── 引擎级限速（每秒最大翻译请求数）──
  // 百度免费版 QPS=1；google_free 免费接口批量请求过高会 429
  "rateLimits": {
    "google_free": 3,
    "google_api": 3,
    "microsoft": 2,
    "baidu": 1,
    "openai": 2,
    "deepl": 2
  },

  // ── 全量扫描并发分组：每 N 个场景一组，组内串行翻译、组间并行（上限 scanAllConcurrency 组）──
  // 非请求合并数：每场景 title+details 合并一次请求；hook 路径固定单场景单请求
  "batchSize": 10,

  // ── 番号正则：标题全文匹配视为纯番号（跳过翻译）；部分匹配时翻译后按原样还原 ──
  "codePattern": "[A-Za-z]{2,10}[-_ ]?\\d{2,6}",

  // ── 最小翻译长度：短于该字符数的标题/简介跳过（防番号/缩写/代词误翻）──
  "minLength": 4,

  // ── 翻译缓存有效期（小时）：同一场景内容一致且在有效期内不重复翻译 ──
  "cacheHours": 24
}
